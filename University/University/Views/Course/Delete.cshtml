@model University.ViewModel.CoursesVM.CourseDeleteViewModel
@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CourseId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.CourseId)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Title)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Credits)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Credits)</dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Department?.DepartmentName</dd>
    </dl>

    @if (Model.Images != null && Model.Images.Any())
    {
        <h4>Files</h4>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var image in Model.Images)
            {
                <div>
                    <img src="~/multipleFileUpload/@image.ExistingFilepath"
                         style="max-width:200px; max-height:200px; object-fit:cover;"
                         class="img-thumbnail" />
                </div>
            }
        </div>
    }
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="CourseId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>