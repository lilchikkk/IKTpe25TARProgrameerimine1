@model University.ViewModel.CoursesVM.CourseUpdateViewModel
@{
    ViewData["Title"] = "Edit Course";
}

<h2>Edit Course</h2>
<form asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" asp-for="CourseId" />
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Credits" class="control-label"></label>
        <input asp-for="Credits" class="form-control" />
        <span asp-validation-for="Credits" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DepartmentId" class="control-label"></label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId">
            <option value="">--Select Department--</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    @if (Model.Images != null && Model.Images.Any())
    {
        <h4>Current Files</h4>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var image in Model.Images)
            {
                <div>
                    <img src="~/multipleFileUpload/@image.ExistingFilepath"
                         style="max-width:200px; max-height:200px; object-fit:cover;"
                         class="img-thumbnail" />
                </div>
            }
        </div>
    }

    <div class="form-group">
        <label asp-for="Files" class="control-label">Upload New Files</label>
        <input asp-for="Files" type="file" class="form-control" multiple />
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>